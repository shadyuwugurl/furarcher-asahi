#!/bin/bash
# ricer - Furarcher desktop ricing for Asahi (GNOME + Hyprland). No sudo, ~/.local only.
# Centre: boykisser + gay boys + furries + femboys, SFW 16+ only. Dark mode everywhere.
#   ricer apply [IMAGE] [THEME]  full rice: wallpaper + theme + kitty + hypr colors + darkmode + dock
#   ricer wallpaper <img>    set wallpaper (GNOME gsettings + Hyprland if present)
#   ricer theme <name>       apply palette (see `ricer themes`)
#   ricer themes             list all pride/love palettes with flag notes
#   ricer mood <name>        one-shot preset: boykisser|mlm|furry|femboy|gaylove|midnight
#   ricer love [name]        wholesome SFW affirmation (mlm / gay love / furry / femboy / boykisser)
#   ricer wallpapers         list bundled SFW wallpapers
#   ricer darkmode           force dark mode: GNOME/GTK/kitty/waybar/wofi/hypr
#   ricer dock               install waybar top-bar + bottom dock + wofi configs (mac-like)
#   ricer macbinds           install Hyprland macOS keybinds + GNOME mac-ish tweaks (safe)
#   ricer mactheme           install WhiteSur-Dark GTK (mac traffic lights, needs network)
#   ricer gpu                Asahi GPU/ANE status: Mesa AGX check + honest ANE note
#   ricer chime [mood|off]   login chime: happy yips + kiss (synth WAV, user unit, no sudo)
#   ricer sounds             full meme sound scheme (web samples -> wavs, login mix, logout sting)
#   ricer grub [mood|restore]  GRUB menu art (sudo, backup kept)
#   ricer splash [mood|restore] Plymouth boot splash (sudo + initramfs rebuild)
#     Firmware limits: power-on Apple logo + chime are Apple firmware (pre-Linux,
#     unchangeable from Linux). These commands theme everything after: GRUB,
#     Plymouth splash, login chime.
#   ricer auto <mood>          fully automatic: web search -> top hit -> full rice (fallback: bundled)
#   ricer find <query> [n] [--source=all|wallhaven|nekos|waifu|safebooru|openverse]  SFW web search (5 providers)
#   ricer get <n> [--apply[=theme]]  download result n (image-validated, logged)
#   ricer preview <n>  show URL + kitty inline preview if available
#   ricer fetch-pack <mood> [n]  download top-n SFW web hits for a mood
#   ricer status             show current rice state
# Flags: --dry-run, --yes
set -u

ROOT="${FURARCHER_ROOT:-$(cd "$(dirname "$0")/.." && pwd)}"
BGDIR="$HOME/.local/share/backgrounds"
KYDIR="$HOME/.config/kitty"
HYDIR="$HOME/.config/hypr"
WBDIR="$HOME/.config/waybar"
WFDIR="$HOME/.config/wofi"
RCACHE="$HOME/.local/share/furarcher"
WH_BASE="${WALLHAVEN_BASE:-https://wallhaven.cc}"
NB_BASE="${NEKOS_BASE:-https://nekos.best}"
WA_BASE="${WAIFU_BASE:-https://api.waifu.im}"
SB_BASE="${SAFEBOORU_BASE:-https://safebooru.org}"
OV_BASE="${OPENVERSE_BASE:-https://api.openverse.org}"
DRY="false"
for a in "$@"; do case "$a" in --dry-run) DRY="true";; esac; done
run() { if [ "$DRY" = "true" ]; then echo "[dry-run] $*"; else eval "$*"; fi; }

palette() { # palette <name> -> "bg fg accent accent2"
  case "$1" in
    boykisser) echo "1a0e1a f5d5ec ff7ad9 b28dff" ;;
    pink)   echo "1a0e1a f5d5ec ff7ad9 ff9ecf" ;;
    femboy) echo "14101e ffe4f4 7ad9ff ff9ecf" ;;
    gay)    echo "101418 f5f5f5 fe0000 ffd900" ;;
    furry)   echo "161020 f5d5ec ff9e5e b28dff" ;;
    mlm)    echo "0b1e22 eafcff 078d70 7ab2ff" ;;
    achillean) echo "0e1a2b f0f6ff 5cb8ff ffd166" ;;
    bear)   echo "171008 f5e8d5 d68c3a 8a5a2b" ;;
    honey)  echo "1c1008 fff3e0 ff9e5e ffb3c8" ;;
    midnight) echo "0d0a18 e2d5ff ff7ad9 5cb8ff" ;;
    paw)    echo "0a0f1e f5d5ec b28dff ff9ecf" ;;
    goldengate) echo "171008 f5e8d5 ff6b35 ffb627" ;;
    purple) echo "120e1e e2d5ff b28dff d0b3ff" ;;
    ocean)  echo "0b1620 d5ecf5 7ad9ff a3e4ff" ;;
    trans)  echo "141821 f5f5f5 5bcffa f5a9b8" ;;
    rainbow) echo "141414 f5f5f5 fe0000 8cff00" ;;
    bi)     echo "161020 f5d5ec d60270 0038a8" ;;
    *) echo "unknown theme: $1 (see: ricer themes)" >&2; return 1 ;;
  esac
}

theme_desc() {
  case "$1" in
    boykisser) echo "boykisser — kissy pink + lavender on near-black. The default house mood." ;;
    pink) echo "pink — classic femboy pink blast." ;;
    femboy) echo "femboy — baby-blue + pink on plum. Soft thigh-high energy, SFW." ;;
    gay) echo "gay — rainbow-first red/gold pop for gay love." ;;
    furry) echo "furry — warm amber paw-orange + lavender, con-floor at midnight." ;;
    mlm) echo "mlm — men-loving-men flag: deep teal, sea-green, white, sky/indigo blue." ;;
    achillean) echo "achillean — mlm variant: gold + sky blue on navy, for boyfriends." ;;
    bear) echo "bear — bear-pride browns + honey gold. Big, warm, cuddly." ;;
    honey) echo "honey (gay love) — sunset pinks + amber. Slow-dance / holding-hands mood." ;;
    midnight) echo "midnight kiss — boykisser after dark: pink + ice blue on violet-black." ;;
    paw) echo "paw (furry night) — lavender + pink on starry navy. Night-walk constellations." ;;
    goldengate) echo "goldengate — macOS 27 Golden Gate vibes: bridge-orange + sunset gold on warm black. Refined glass, uniform chrome." ;;
    purple) echo "purple — royal lavender haze." ;;
    ocean) echo "ocean — cool Asahi blues." ;;
    trans) echo "trans — light blue / pink / white pride." ;;
    rainbow) echo "rainbow — full six-stripe pride pop." ;;
    bi) echo "bi — pink / purple / blue pride." ;;
  esac
}

cmd_themes() {
  echo "furarcher pride/love palettes (all dark-mode, SFW):"
  for t in boykisser pink femboy gay furry mlm achillean bear honey midnight paw goldengate purple ocean trans rainbow bi; do
    printf "  %-10s %s\n" "$t" "$(theme_desc "$t")"
  done
  echo "use: ricer theme <name> | ricer mood <name>"
}

mood_theme() { # mood -> palette name (moods and palettes differ: gaylove->honey, furry->paw)
  case "$1" in
    boykisser) echo "boykisser" ;;
    mlm) echo "mlm" ;;
    furry) echo "paw" ;;
    femboy) echo "femboy" ;;
    gaylove) echo "honey" ;;
    midnight) echo "midnight" ;;
    bear) echo "bear" ;;
    achillean) echo "achillean" ;;
    *) echo "boykisser" ;;
  esac
}

do_wallpaper() { # do_wallpaper <img>
  img="$1"
  [ -f "$img" ] || { echo "no such image: $img"; return 1; }
  run "mkdir -p \"$BGDIR\""
  base=$(basename "$img")
  if [ "$img" != "$BGDIR/$base" ]; then
    run "cp -f \"$img\" \"$BGDIR/\""
  fi
  case "$base" in *.gif|*.GIF)
    # animated wallpaper via mpvpaper (hyprpaper is static-only)
    if command -v mpvpaper >/dev/null 2>&1; then
      run "pkill -x hyprpaper 2>/dev/null || true"
      run "nohup mpvpaper -o \"loop-file=inf no-audio panscan=1.0\" eDP-1 \"$BGDIR/$base\" >/dev/null 2>&1 &"
      if [ -f "$HYDIR/hyprland.conf" ]; then
        run "sed -i 's|^exec-once = hyprpaper|#exec-once = hyprpaper|' \"$HYDIR/hyprland.conf\""
        if grep -q "exec-once = mpvpaper" "$HYDIR/hyprland.conf" 2>/dev/null; then
          run "sed -i 's|^.*exec-once = mpvpaper.*|exec-once = mpvpaper -o \"loop-file=inf no-audio panscan=1.0\" eDP-1 $BGDIR/$base \\&|' \"$HYDIR/hyprland.conf\""
        else
          run "echo 'exec-once = mpvpaper -o \"loop-file=inf no-audio panscan=1.0\" eDP-1 $BGDIR/$base &' >> \"$HYDIR/hyprland.conf\""
        fi
      fi
      echo "wallpaper: $base (animated via mpvpaper)"
      return 0
    else
      echo "(mpvpaper missing - sudo dnf install -y mpvpaper for animated GIFs)"
    fi ;;
  esac
  case "$base" in *.png|*.jpg|*.jpeg) fit_wallpaper "$BGDIR/$base" ;; esac
  if command -v gsettings >/dev/null 2>&1; then
    run "gsettings set org.gnome.desktop.background picture-uri \"file://$BGDIR/$base\""
    run "gsettings set org.gnome.desktop.background picture-uri-dark \"file://$BGDIR/$base\""
    run "gsettings set org.gnome.desktop.background picture-options zoom || true"
  else
    echo "(gsettings missing - GNOME wallpaper skipped)"
  fi
  if command -v swww >/dev/null 2>&1; then
    run "swww img \"$BGDIR/$base\" || true"
  elif command -v hyprpaper >/dev/null 2>&1; then
    # back to static: re-enable hyprpaper autostart, drop any mpvpaper line
    if [ -f "$HYDIR/hyprland.conf" ]; then
      run "sed -i 's|^#exec-once = hyprpaper|exec-once = hyprpaper|' \"$HYDIR/hyprland.conf\""
      run "sed -i '/mpvpaper -o/d' \"$HYDIR/hyprland.conf\""
    fi
    run "pkill -x mpvpaper 2>/dev/null || true"
    # hyprpaper (0.7+ config style): rewrite hyprpaper.conf, live-reload if in session
    hp=""
    case "$img" in
      *.svg) hp="$BGDIR/.hyprpaper.png"; to_png "$img" 1920 "$hp" || hp="" ;;
      *.png|*.jpg|*.jpeg) hp="$BGDIR/$base" ;;
    esac
    if [ -n "$hp" ] && { [ -f "$hp" ] || [ "$DRY" = "true" ]; }; then
      run "mkdir -p \"$HYDIR\""
      # hyprpaper 0.8: anonymous `wallpaper {` blocks, NO '=' and NO preload line
      run "cat > \"$HYDIR/hyprpaper.conf\" <<EOF
wallpaper {
    monitor = eDP-1
    path = $hp
    fit_mode = cover
}
wallpaper {
    monitor =
    path = $hp
    fit_mode = cover
}
splash = false
ipc = on
EOF"
      run "hyprctl hyprpaper wallpaper \"eDP-1,$hp\" 2>/dev/null || hyprctl hyprpaper wallpaper \",$hp\" 2>/dev/null || true"
    fi
  else
    echo "(no swww/hyprpaper - Hyprland wallpaper only on next ricer with a backend)"
  fi
  echo "wallpaper: $base"
}

do_theme() { # do_theme <name>
  read -r bg fg ac ac2 < <(palette "$1") || return 1
  run "mkdir -p \"$KYDIR\" \"$HYDIR\""
  run "cat > \"$KYDIR/furarcher-theme.conf\" <<EOF
# furarcher $1 - generated by ricer, do not hand-edit (dark mode)
background #$bg
foreground #$fg
color1 #$ac
color5 #$ac
color13 #$ac2
EOF"
  if [ -f "$KYDIR/kitty.conf" ] && ! grep -q "furarcher-theme.conf" "$KYDIR/kitty.conf" 2>/dev/null; then
    run "echo 'include furarcher-theme.conf' >> \"$KYDIR/kitty.conf\""
  fi
  run "cat > \"$HYDIR/furarcher-colors.conf\" <<EOF
# furarcher $1 - generated by ricer (dark)
general {
    col.active_border = rgba(${ac}ee) rgba(${ac2}ee) 45deg
    col.inactive_border = rgba(444444aa)
}
EOF"
  if [ -f "$HYDIR/hyprland.conf" ] && ! grep -q "furarcher-colors.conf" "$HYDIR/hyprland.conf" 2>/dev/null; then
    run "echo 'source = ~/.config/hypr/furarcher-colors.conf' >> \"$HYDIR/hyprland.conf\""
  fi
  run "mkdir -p \"$RCACHE\" && echo \"$1\" > \"$RCACHE/theme\""
  echo "theme: $1 (#$ac) — $(theme_desc "$1")"
}

do_darkmode() {
  echo "forcing dark mode everywhere (GNOME/GTK/kitty/waybar/wofi)..."
  run "mkdir -p \"$KYDIR\" \"$WBDIR\" \"$WFDIR\""
  if command -v gsettings >/dev/null 2>&1; then
    run "gsettings set org.gnome.desktop.interface gtk-theme 'adw-gtk3-dark' || true"
    run "gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark' || true"
    run "gsettings set org.gnome.desktop.interface icon-theme 'Adwaita' || true"
    # flatpak GTK dark override best-effort
    if command -v flatpak >/dev/null 2>&1; then run "flatpak override --user --env=GTK_THEME=adw-gtk3-dark || true"; fi
  else
    echo "(no gsettings - GNOME dark skipped)"
  fi
  # kitty: ensure dark background even without theme file
  if [ ! -f "$KYDIR/furarcher-theme.conf" ]; then
    run "printf '# furarcher dark fallback\nbackground #1a0e1a\nforeground #f5d5ec\n' > \"$KYDIR/furarcher-theme.conf\""
  fi
  # waybar/wofi dark files are installed by 'ricer dock'; ensure they exist note
  echo "darkmode: done (if waybar/wofi missing, run: ricer dock)"
}

do_dock() {
  echo "installing mac-like top bar + bottom dock (waybar) + wofi dark + kitty love..."
  run "mkdir -p \"$WBDIR\" \"$WFDIR\" \"$HYDIR\" \"$KYDIR\""
  run "cp -f \"$ROOT/config/hypr/waybar-config.jsonc\" \"$WBDIR/furarcher-top.jsonc\""
  run "cp -f \"$ROOT/config/hypr/waybar-style.css\" \"$WBDIR/furarcher-top.css\""
  run "cp -f \"$ROOT/config/hypr/waybar-dock.jsonc\" \"$WBDIR/furarcher-dock.jsonc\""
  run "cp -f \"$ROOT/config/hypr/waybar-dock.css\" \"$WBDIR/furarcher-dock.css\""
  run "cp -f \"$ROOT/config/wofi-style.css\" \"$WFDIR/style.css\""
  run "cp -f \"$ROOT/config/kitty-furarcher.conf\" \"$KYDIR/kitty-furarcher.conf\""
  run "mkdir -p \"$HOME/.config/mako\""
  run "cp -f \"$ROOT/config/mako-config\" \"$HOME/.config/mako/config\""
  run "makoctl reload 2>/dev/null || true"
  if [ -f "$KYDIR/kitty.conf" ] && ! grep -q "kitty-furarcher.conf" "$KYDIR/kitty.conf" 2>/dev/null; then
    run "echo 'include kitty-furarcher.conf' >> \"$KYDIR/kitty.conf\""
  fi
  echo "dock: top bar + bottom dock + kitty love installed."
  echo "Hyprland autostart already launches both (see config/hypr/hyprland.conf). Log out/in or: pkill waybar; waybar &"
}

do_macbinds() {
  echo "installing macOS-style keybinds (SUPER = Cmd)..."
  run "mkdir -p \"$HYDIR\""
  run "cp -f \"$ROOT/config/hypr/hyprland.conf\" \"$HYDIR/hyprland.conf\""
  if command -v gsettings >/dev/null 2>&1; then
    # GNOME mac parity: traffic-light side, natural scroll, mac shortcut order
    run "gsettings set org.gnome.desktop.peripherals.touchpad natural-scroll true || true"
    run "gsettings set org.gnome.desktop.wm.preferences button-layout 'close,minimize,maximize:' || true"
    run "gsettings set org.gnome.desktop.wm.keybindings close \"['<Super>q', '<Alt>F4']\" || true"
    run "gsettings set org.gnome.desktop.wm.keybindings switch-applications \"['<Super>Tab']\" || true"
    run "gsettings set org.gnome.desktop.wm.keybindings switch-input-source \"['<Control>space']\" || true"
    run "gsettings set org.gnome.settings-daemon.plugins.media-keys screenshot \"['<Super><Shift>3']\" || true"
    run "gsettings set org.gnome.settings-daemon.plugins.media-keys area-screenshot \"['<Super><Shift>4']\" || true"
    echo "(GNOME: Cmd+Q close, Cmd+Tab apps, Ctrl+Space input, Cmd+Shift+3/4 shots)"
  fi
  echo "macbinds: Hyprland full mac map + kitty Cmd keys + GNOME mac order."
}

do_mactheme() {
  # macOS look: WhiteSur GTK (real traffic-light buttons, left side) + dark.
  # Pure CSS/SVG theme -> works on aarch64. Network needed (git clone).
  echo "installing macOS-style WhiteSur-Dark GTK theme (traffic lights)..."
  command -v git >/dev/null 2>&1 || { echo "need git: sudo dnf install -y git"; return 1; }
  run "mkdir -p \"$HOME/.themes\""
  if [ ! -d /tmp/WhiteSur-gtk-theme ]; then
    run "git clone --depth 1 https://github.com/vinceliuice/WhiteSur-gtk-theme.git /tmp/WhiteSur-gtk-theme" || return 1
  fi
  run "bash /tmp/WhiteSur-gtk-theme/install.sh -d \"$HOME/.themes\"" || { echo "WhiteSur installer failed (see output above)"; return 1; }
  if [ -d "$HOME/.themes/WhiteSur-Dark" ]; then
    if command -v gsettings >/dev/null 2>&1; then
      run "gsettings set org.gnome.desktop.interface gtk-theme 'WhiteSur-Dark' || true"
      run "gsettings set org.gnome.desktop.wm.preferences button-layout 'close,minimize,maximize:' || true"
      if command -v flatpak >/dev/null 2>&1; then run "flatpak override --user --env=GTK_THEME=WhiteSur-Dark || true"; fi
    fi
    if [ -f "$HYDIR/hyprland.conf" ] && grep -q "env = GTK_THEME,adw-gtk3-dark" "$HYDIR/hyprland.conf" 2>/dev/null; then
      run "sed -i 's|env = GTK_THEME,adw-gtk3-dark|env = GTK_THEME,WhiteSur-Dark|' \"$HYDIR/hyprland.conf\""
    fi
    # matching mac cursors (pure assets, aarch64-safe, best-effort)
    if [ ! -d /tmp/WhiteSur-cursors ]; then
      run "git clone --depth 1 https://github.com/vinceliuice/WhiteSur-cursors.git /tmp/WhiteSur-cursors || true"
    fi
    if [ -d /tmp/WhiteSur-cursors ]; then
      run "mkdir -p \"$HOME/.icons\""
      run "bash /tmp/WhiteSur-cursors/install.sh -d \"$HOME/.icons\" || true"
    fi
    if [ -d "$HOME/.icons/WhiteSur-cursors" ] && command -v gsettings >/dev/null 2>&1; then
      run "gsettings set org.gnome.desktop.interface cursor-theme 'WhiteSur-cursors' || true"
      run "gsettings set org.gnome.desktop.interface cursor-size 24 || true"
    fi
    echo "mactheme: WhiteSur-Dark active (log out/in for full effect)."
  else
    echo "WhiteSur-Dark dir missing after install - open /tmp/WhiteSur-gtk-theme to inspect."
    return 1
  fi
}

do_gpu() {
  echo "== Asahi M1 GPU / ANE status =="
  echo "arch: $(uname -m) | kernel: $(uname -r)"
  if grep -qi asahi /proc/version 2>/dev/null || [ -f /etc/asahi-release ]; then
    echo "Asahi kernel: YES"
  else
    echo "Asahi kernel: NOT detected (GPU bits below still try Mesa)"
  fi
  for t in glxinfo vulkaninfo; do
    if command -v "$t" >/dev/null 2>&1; then
      echo "--- $t ---"
      "$t" 2>/dev/null | grep -iE "apple|asahi|agx|M1|renderer|driver" | head -8 || true
    else
      echo "$t: missing (dnf install -y glx-utils vulkan-tools)"
    fi
  done
  if ls /dev/dri 2>/dev/null; then echo "DRI nodes: $(ls /dev/dri 2>/dev/null | tr '\n' ' ')"; else echo "DRI: /dev/dri missing"; fi
  echo ""
  echo "GPU: Asahi AGX via Mesa (open) — Hyprland/GNOME use it when kernel + mesa-asahi present."
  if command -v pacman >/dev/null 2>&1; then
    echo "  Ensure on Asahi Alarm: sudo pacman -S --needed mesa vulkan-tools (asahi-alarm kernel)"
  else
    echo "  Ensure on Asahi Fedora: sudo dnf install -y mesa-dri-drivers mesa-vulkan-drivers"
  fi
  echo "ANE (Apple Neural Engine): NO Linux driver exists (Apple firmware, no upstream support)."
  echo "  AI runs on CPU (+ GPU offload where Ollama/llama.cpp supports it on ARM)."
  echo "  On 8GB M1 Air keep models <=8B Q4 (e.g. hermes3:8b) to avoid OOM."
}

mood_svg() { # mood -> bundled wallpaper svg
  case "$1" in
    boykisser|midnight) echo "$ROOT/wallpapers/boykisser-dark-2560x1664.svg" ;;
    mlm|achillean) echo "$ROOT/wallpapers/boykisser-mlm-2560x1664.svg" ;;
    furry|bear) echo "$ROOT/wallpapers/furry-paws-night-2560x1664.svg" ;;
    femboy) echo "$ROOT/wallpapers/fur-pride-2560x1664.svg" ;;
    gaylove) echo "$ROOT/wallpapers/gaylove-sunset-2560x1664.svg" ;;
    *) echo "$ROOT/wallpapers/boykisser-dark-2560x1664.svg" ;;
  esac
}

do_mood() { # do_mood <name> — wallpaper + theme preset, SFW
  case "$1" in
    boykisser|mlm|furry|femboy|gaylove|midnight|bear|achillean) ;;
    *) echo "unknown mood: $1 (boykisser|mlm|furry|femboy|gaylove|midnight|bear|achillean)" >&2; return 1 ;;
  esac
  do_wallpaper "$(mood_svg "$1")" && do_theme "$(mood_theme "$1")" || return 1
  do_darkmode >/dev/null
  echo "mood: $1 ^_^"
}

do_love() { # do_love [mlm|gaylove|furry|femboy|boykisser] — wholesome SFW note
  m="${1:-gaylove}"
  case "$m" in
    mlm)       echo "💙 men loving men: two boyfriends, one blanket fort, zero rush. You + him vs. the render queue. :3" ;;
    gaylove)   echo "💗 gay love note: holding hands counts as a workout when the world stares. Kiss on the cheek, forehead first. You are loved." ;;
    furry)     echo "🐾 furry love: tail wags mean yes, ear flicks mean maybe-later. Consent + headpats + shared fries." ;;
    femboy)    echo "🎀 femboy love: thigh-highs are armor (+2 CHA). You look soft AND strong. Hydrate, stretch, slay." ;;
    boykisser) echo "😽 boykisser says: muah! cheek kiss delivered. You did great today. Drink water, text him back." ;;
    bear)      echo "🐻 bear hug dispatched: big, warm, SFW. You are safe here, cub." ;;
    *) echo "unknown love: $m (mlm|gaylove|furry|femboy|boykisser|bear)" >&2; return 1 ;;
  esac
}

cmd_wallpapers() {
  echo "bundled SFW wallpapers ($ROOT/wallpapers):"
  ls -1 "$ROOT/wallpapers" 2>/dev/null | sed 's/^/  /' || echo "  (none)"
  echo "use: ricer wallpaper <file> | ricer mood <name> | ricer apply [IMAGE] [theme]"
}

fit_wallpaper() { # fit_wallpaper <file> — downscale raster wider than 1920px (hyprpaper blacks out huge images on Asahi)
  f="$1"
  if [ "$DRY" = "true" ]; then return 0; fi
  [ -f "$f" ] || return 0
  w=""
  if command -v identify >/dev/null 2>&1; then w=$(identify -format "%w" "$f" 2>/dev/null || echo ""); fi
  case "$w" in ''|*[!0-9]*) return 0 ;; esac
  if [ "$w" -gt 1920 ]; then
    if command -v magick >/dev/null 2>&1; then magick "$f" -resize "1920x>" "$f" || return 1
    elif command -v convert >/dev/null 2>&1; then convert "$f" -resize "1920x>" "$f" || return 1
    elif command -v ffmpeg >/dev/null 2>&1; then ffmpeg -y -v error -i "$f" -vf "scale=1920:-1" "${f}.fit.png" && mv -f "${f}.fit.png" "$f" || return 1
    else echo "(image ${w}px wide but no resizer found - hyprpaper may show it black; install imagemagick: sudo dnf install -y ImageMagick)"; fi
    echo "resized wallpaper to 1920px wide for hyprpaper"
  fi
}

to_png() { # to_png <svg> <width> <out.png> — rsvg -> inkscape -> convert -> stdlib fallback
  svg="$1"; w="$2"; out="$3"
  if [ "$DRY" = "true" ]; then echo "[dry-run] render $svg (${w}px) -> $out"; return 0; fi
  mkdir -p "$(dirname "$out")"
  if command -v rsvg-convert >/dev/null 2>&1; then
    rsvg-convert -w "$w" -o "$out" "$svg" 2>/dev/null && [ -s "$out" ] && return 0
  fi
  if command -v inkscape >/dev/null 2>&1; then
    inkscape --export-type=png --export-filename="$out" -w "$w" "$svg" >/dev/null 2>&1 \
      && [ -s "$out" ] && return 0
  fi
  if command -v convert >/dev/null 2>&1; then
    convert -background none -resize "${w}x" "$svg" "$out" >/dev/null 2>&1 \
      && [ -s "$out" ] && return 0
  fi
  if python3 "$ROOT/plymouth/svg-to-png.py" "$w" "$out" 2>/dev/null; then
    echo "note: no SVG converter found - stdlib gradient fallback (no art detail)."
    if command -v pacman >/dev/null 2>&1; then
      echo "  for full art: sudo pacman -S --needed librsvg   (rsvg-convert)"
    else
      echo "  for full art: sudo dnf install -y librsvg2-tools   (rsvg-convert)"
    fi
    return 0
  fi
  echo "PNG render failed (no converter and stdlib fallback failed)"; return 1
}

do_chime() { # chime [boykisser|mlm|yippee|off] — login chime via user systemd unit (no sudo)
  m="${1:-boykisser}"
  if [ "$m" = "off" ]; then
    run "systemctl --user disable --now furarcher-chime.service || true"
    echo "chime: off"
    return 0
  fi
  case "$m" in boykisser|mlm|yippee) ;;
    *) echo "unknown chime: $m (boykisser|mlm|yippee|off)" >&2; return 1 ;;
  esac
  command -v python3 >/dev/null || { echo "need python3"; return 1; }
  run "mkdir -p \"$HOME/.local/share/sounds\" \"$HOME/.config/systemd/user\""
  wav="$HOME/.local/share/sounds/furarcher-chime-$m.wav"
  run "python3 \"$ROOT/sounds/make-chime.py\" \"$m\" \"$wav\"" || return 1
  player=""
  for p in pw-play paplay; do
    if command -v "$p" >/dev/null 2>&1; then player="$(command -v "$p")"; break; fi
  done
  if [ -z "$player" ]; then
    if command -v ffplay >/dev/null 2>&1; then player="$(command -v ffplay) -nodisp -autoexit -loglevel quiet"
    else
      echo "warn: no audio player (pw-play/paplay/ffplay) - unit installed anyway;"
      echo "  sudo dnf install -y pipewire-utils   (pw-play)"
      player="/usr/bin/pw-play"
    fi
  fi
  run "cat > \"$HOME/.config/systemd/user/furarcher-chime.service\" <<EOF
[Unit]
Description=Furarcher login chime ($m)
After=pipewire.service pipewire-pulse.service
[Service]
Type=oneshot
ExecStart=$player $wav
[Install]
WantedBy=graphical-session.target
EOF"
  run "systemctl --user daemon-reload || echo '(no user bus - enable manually: systemctl --user enable furarcher-chime)'"
  run "systemctl --user enable furarcher-chime.service || true"
  if [ "$DRY" != "true" ] && [ -f "$wav" ]; then
    echo "preview (best-effort):"
    $player "$wav" 2>/dev/null || true
  fi
  echo "chime: $m installed (plays at graphical login)"
}

grub_cfg() { # grub.cfg path, Fedora vs Arch (override GRUB_CFG for tests)
  if [ -n "${GRUB_CFG:-}" ]; then echo "$GRUB_CFG"; return 0; fi
  if [ -f /boot/grub2/grub.cfg ]; then echo "/boot/grub2/grub.cfg"
  elif [ -f /boot/grub/grub.cfg ]; then echo "/boot/grub/grub.cfg"
  else echo "/boot/grub2/grub.cfg"
  fi
}

do_grub() { # grub [mood|restore] — GRUB menu background (sudo, backup kept)
  GCFG="$(grub_cfg)"; GBG="$(dirname "$GCFG")/furarcher-bg.png"
  if [ "${1:-}" = "restore" ]; then
    [ -f "$RCACHE/grub.bak" ] || { echo "no GRUB backup (run 'ricer grub <mood>' first)"; return 1; }
    run "sudo cp -f \"$RCACHE/grub.bak\" /etc/default/grub" || return 1
    run "sudo grub2-mkconfig -o \"$GCFG\"" || return 1
    echo "grub: restored stock background"
    return 0
  fi
  mood="${1:-boykisser}"
  case "$mood" in boykisser|mlm|furry|femboy|gaylove|midnight|bear|achillean) ;;
    *) echo "unknown mood: $mood" >&2; return 1 ;;
  esac
  command -v grub2-mkconfig >/dev/null 2>&1 || { echo "need grub2 (Fedora: grub2-tools / Arch: grub)"; return 1; }
  png="$RCACHE/grub-bg.png"
  to_png "$(mood_svg "$mood")" 1920 "$png" || return 1
  run "sudo cp -n /etc/default/grub /etc/default/grub.furarcher-bak"
  run "mkdir -p \"$RCACHE\" && sudo cat /etc/default/grub > \"$RCACHE/grub.bak\""
  run "sudo sed -i '/^GRUB_BACKGROUND=/d' /etc/default/grub"
  run "sudo sh -c 'echo GRUB_BACKGROUND=$GBG >> /etc/default/grub'"
  run "sudo sh -c 'sed -i \"/^GRUB_DISTRIBUTOR=/d\" /etc/default/grub && echo GRUB_DISTRIBUTOR=\"Boykisser OS\" >> /etc/default/grub'"
  run "sudo cp -f \"$png\" \"$GBG\"" || return 1
  run "sudo grub2-mkconfig -o \"$GCFG\"" || return 1
  echo "grub: boykisser menu art active next reboot. Restore: ricer grub restore"
}

do_splash() { # splash [mood|restore] — Plymouth boot splash (sudo + initramfs rebuild)
  if [ "${1:-}" = "restore" ]; then
    if [ -f "$RCACHE/plymouth-backup" ] && command -v plymouth-set-default-theme >/dev/null 2>&1; then
      run "sudo plymouth-set-default-theme -R \"$(cat "$RCACHE/plymouth-backup")\"" || return 1
      echo "splash: restored to $(cat "$RCACHE/plymouth-backup")"
      return 0
    fi
    if [ -f "$RCACHE/mkinitcpio.bak" ]; then
      MCONF="${MKINITCPIO_CONF:-/etc/mkinitcpio.conf}"
      run "sudo cp -f \"$RCACHE/mkinitcpio.bak\" \"$MCONF\"" || return 1
      run "sudo mkinitcpio -P" || return 1
      echo "splash: mkinitcpio config restored + rebuilt"
      return 0
    fi
    echo "no Plymouth backup (run 'ricer splash <mood>' first)"; return 1
  fi
  mood="${1:-boykisser}"
  case "$mood" in boykisser|mlm|furry|femboy|gaylove|midnight|bear|achillean) ;;
    *) echo "unknown mood: $mood" >&2; return 1 ;;
  esac
  if command -v plymouth-set-default-theme >/dev/null 2>&1; then
    splash_fedora "$mood"
  elif command -v mkinitcpio >/dev/null 2>&1; then
    splash_arch "$mood"
  else
    echo "need plymouth (Fedora: plymouth-theme-spinner / Arch: plymouth)"; return 1
  fi
}

splash_fedora() { # splash_fedora <mood> — dracut path
  mood="$1"
  SDIR="${PLYMOUTH_THEMES_DIR:-/usr/share/plymouth/themes}"
  [ -d "$SDIR/spinner" ] || { echo "need stock spinner assets: sudo dnf install -y plymouth-theme-spinner"; return 1; }
  png="$RCACHE/splash-watermark.png"
  to_png "$(mood_svg "$mood")" 480 "$png" || return 1
  run "sudo mkdir -p /usr/share/plymouth/themes/furarcher"
  run "sudo cp -f /usr/share/plymouth/themes/spinner/*.png /usr/share/plymouth/themes/furarcher/"
  run "sudo cp -f \"$ROOT/plymouth/furarcher.plymouth\" /usr/share/plymouth/themes/furarcher/"
  run "sudo cp -f \"$png\" /usr/share/plymouth/themes/furarcher/watermark.png"
  run "plymouth-set-default-theme > \"$RCACHE/plymouth-backup\""
  run "sudo plymouth-set-default-theme -R furarcher" || return 1
  echo "splash: furarcher Plymouth active next reboot (initramfs rebuilt). Restore: ricer splash restore"
}

splash_arch() { # splash_arch <mood> — mkinitcpio path (Asahi Alarm / Arch)
  mood="$1"
  SDIR="${PLYMOUTH_THEMES_DIR:-/usr/share/plymouth/themes}"
  [ -d "$SDIR/spinner" ] || { echo "need plymouth theme assets: sudo pacman -S --needed plymouth"; return 1; }
  MCONF="${MKINITCPIO_CONF:-/etc/mkinitcpio.conf}"
  [ -f "$MCONF" ] || { echo "no $MCONF (not an mkinitcpio system?)"; return 1; }
  png="$RCACHE/splash-watermark.png"
  to_png "$(mood_svg "$mood")" 480 "$png" || return 1
  run "sudo mkdir -p /usr/share/plymouth/themes/furarcher"
  run "sudo cp -f \"$SDIR/spinner/\"*.png /usr/share/plymouth/themes/furarcher/"
  run "sudo cp -f \"$ROOT/plymouth/furarcher.plymouth\" /usr/share/plymouth/themes/furarcher/"
  run "sudo cp -f \"$png\" /usr/share/plymouth/themes/furarcher/watermark.png"
  run "mkdir -p \"$RCACHE\" && sudo cat \"$MCONF\" > \"$RCACHE/mkinitcpio.bak\""
  run "sudo sh -c 'grep -q plymouth $MCONF || sed -i \"s/udev/udev plymouth/\" $MCONF'"
  run "printf '[Daemon]\nTheme=furarcher\n' | sudo tee /etc/plymouth/plymouthd.conf >/dev/null"
  run "sudo mkinitcpio -P" || return 1
  echo "splash: furarcher Plymouth active next reboot (mkinitcpio rebuilt). Restore: ricer splash restore"
}

sound_url() { # sound_url <name> -> mp3 url (FUR_SOUNDS_MIRROR overrides base for tests)
  case "$1" in
    boykisser-meow) echo "https://sounds.myinstantplay.com/boykisser-meow.mp3" ;;
    *) echo "${FUR_SOUNDS_MIRROR:-https://www.myinstants.com/media/sounds}/$1.mp3" ;;
  esac
}

do_sounds() {
  # Full meme sound scheme (personal-use samples, downloaded on-target only):
  #   boot/login  = boykisser meow + yippee-autism mix
  #   logout      = bye-bye mewing (hyprland exec-shutdown, best-effort)
  #   app open    = dexter meme (fur-sounds daemon watches Hyprland windows)
  #   success     = verity edit (run: fur-win)
  command -v curl >/dev/null 2>&1 || { echo "need curl"; return 1; }
  command -v ffmpeg >/dev/null 2>&1 || { echo "need ffmpeg (Fedora: ffmpeg-free / Arch: ffmpeg)"; return 1; }
  SND="$HOME/.local/share/sounds"
  run "mkdir -p \"$SND\""
  ok=0
  for pair in "boykisser-meow boykisser-meow" "yippeee-autism yippee-autism" "bye-bye-mewing bye-mewing" "dexter-meme dexter" "verity-edit verity"; do
    set -- $pair; src="$1"; out="furarcher-$2.wav"
    echo "fetching $src ..."
    if run "curl -fsSL --max-time 60 -A \"furarcher-asahi/ricer\" -o \"$SND/.$out.mp3\" \"$(sound_url "$src")\""; then
      if run "ffmpeg -y -v error -i \"$SND/.$out.mp3\" -ar 44100 -ac 1 -sample_fmt s16 -filter:a \"loudnorm=I=-16:TP=-1.5:LRA=7\" \"$SND/$out\""; then
        ok=$((ok + 1))
      else echo "convert failed: $src"; fi
      run "rm -f \"$SND/.$out.mp3\""
    else echo "download failed: $src"; fi
  done
  [ "$ok" = "5" ] || { echo "sound scheme incomplete ($ok/5) - check network and retry"; return 1; }
  echo "mixing login sting (meow + yippee)..."
  run "ffmpeg -y -v error -i \"$SND/furarcher-boykisser-meow.wav\" -i \"$SND/furarcher-yippee-autism.wav\" -filter_complex \"[0:a][1:a]concat=n=2:v=0:a=1\" \"$SND/furarcher-chime-login.wav\"" || return 1
  player="/usr/bin/pw-play"
  command -v pw-play >/dev/null 2>&1 && player="$(command -v pw-play)"
  command -v pw-play >/dev/null 2>&1 || { command -v paplay >/dev/null 2>&1 && player="$(command -v paplay)"; }
  run "mkdir -p \"$HOME/.config/systemd/user\""
  run "cat > \"$HOME/.config/systemd/user/furarcher-chime.service\" <<EOF
[Unit]
Description=Furarcher login chime (boykisser meow + yippee)
After=pipewire.service pipewire-pulse.service
[Service]
Type=oneshot
ExecStart=$player $SND/furarcher-chime-login.wav
[Install]
WantedBy=graphical-session.target
EOF"
  run "systemctl --user daemon-reload || true"
  run "systemctl --user enable furarcher-chime.service || true"
  run "mkdir -p \"$HYDIR\""
  if ! grep -q "exec-shutdown" "$HYDIR/hyprland.conf" 2>/dev/null; then
    run "echo 'exec-shutdown = $player $SND/furarcher-bye-mewing.wav || true' >> \"$HYDIR/hyprland.conf\""
  fi
  FURBIN="$(command -v fur-sounds 2>/dev/null || echo "$ROOT/bin/fur-sounds")"
  if ! grep -q "fur-sounds" "$HYDIR/hyprland.conf" 2>/dev/null; then
    run "echo 'exec-once = $FURBIN &' >> \"$HYDIR/hyprland.conf\""
  fi
  if [ "$DRY" != "true" ] && [ -f "$SND/furarcher-chime-login.wav" ]; then
    echo "preview (best-effort):"
    $player "$SND/furarcher-chime-login.wav" 2>/dev/null || true
  fi
  echo "sounds: boot meow + login yippee + logout bye + app dexter + win verity ^_^"
}

cmd_status() {  echo "DE: ${XDG_CURRENT_DESKTOP:-unknown} | session: ${XDG_SESSION_TYPE:-unknown}"
  echo "mood: boykisser + gay boys + furries + femboys (SFW dark)"
  echo "theme: $(cat "$RCACHE/theme" 2>/dev/null || echo '(none yet — try: ricer theme boykisser)')"
  echo "gnome bg: $(gsettings get org.gnome.desktop.background picture-uri 2>/dev/null || echo '(no gsettings)')"
  echo "gtk: $(gsettings get org.gnome.desktop.interface gtk-theme 2>/dev/null || echo '(no gsettings)')"
  echo "color-scheme: $(gsettings get org.gnome.desktop.interface color-scheme 2>/dev/null || echo '(no gsettings)')"
  echo "kitty theme: $(ls "$KYDIR/furarcher-theme.conf" 2>/dev/null || echo '(none)')"
  echo "hypr colors: $(ls "$HYDIR/furarcher-colors.conf" 2>/dev/null || echo '(none)')"
  echo "waybar top: $(ls "$WBDIR/furarcher-top.jsonc" 2>/dev/null || echo '(none)')"
  echo "waybar dock: $(ls "$WBDIR/furarcher-dock.jsonc" 2>/dev/null || echo '(none)')"
  echo "chime: $(systemctl --user is-enabled furarcher-chime.service 2>/dev/null || echo 'off')"
  echo "grub bg: $(grep '^GRUB_BACKGROUND=' /etc/default/grub 2>/dev/null || echo '(stock)')"
  echo "plymouth: $(plymouth-set-default-theme 2>/dev/null || grep -h '^Theme=' /etc/plymouth/plymouthd.conf 2>/dev/null || echo '(plymouth missing)')"
  echo "wal: $(command -v wal 2>/dev/null || echo '(not installed)')"
}

# Web fetch: SFW-only wallpaper search across 5 providers.
#   wallhaven (purity=100 SFW-only) + nekos.best (neko/husbando/kitsune SFW) + waifu.im (is_nsfw=false)
#   + safebooru (SFW-only imageboard, danbooru API) + openverse (CC photos/illustration).
#   waifu.im is kept as a best-effort source but currently 403s keyless curl
#   (bot protection, verified 2026-10-05) — failures are silent/empty by design.
#   Reddit/Pinterest are intentionally NOT queried: both serve login walls / JS shells
#   to keyless curl (verified 2026-10-05). Reddit works only with an OAuth app token;
#   Pinterest has no public search API. Safebooru covers the imageboard need SFW-only.
#   Mood-aware: mlm/gaylove -> husbando + "anime boy couple"; furry -> kitsune + "fox wolf furry", etc.
#   Env overrides for tests/offline mirrors: WALLHAVEN_BASE, NEKOS_BASE, WAIFU_BASE, SAFEBOORU_BASE, OPENVERSE_BASE.
cmd_find() { # find <query> [count] [--source=all|wallhaven|nekos|waifu|safebooru|openverse]
  command -v python3 >/dev/null || { echo "need python3"; return 1; }
  q="$1"; shift || true
  n="6"; src="all"
  for a in "$@"; do case "$a" in
    --source=*) src="${a#--source=}" ;;
    [0-9]*) n="$a" ;;
  esac; done
  mkdir -p "$RCACHE"
  # mood -> provider routing
  nb_ep="neko"; wh_q="$q"
  case "$q" in
    *[Mm][Ll][Mm]*|*gay*|*Gay*|*husbando*|*boyfriend*|*achillean*|*bear*|*femboy*|*Femboy*|*boy*)
      nb_ep="husbando"; echo "mlm/gay boys route -> nekos.best husbando (SFW)..." ;;
    *[Ff]urry*|*fox*|*Fox*|*wolf*|*Wolf*|*kitsune*|*paw*|*Paw*)
      nb_ep="kitsune"; echo "furry route -> nekos.best kitsune (SFW)..." ;;
    *[Nn]eko*|*cat*|*kitten*|*[Bb]oykisser*)
      nb_ep="neko"; echo "neko/boykisser route -> nekos.best neko (SFW)..." ;;
  esac
  case "$q" in
    mlm|achillean|gaylove|boyfriend) wh_q="anime boy couple pastel" ;;
    femboy|Femboy) wh_q="femboy pastel" ;;
    furry|paw|fox|wolf|bear) wh_q="fox wolf furry" ;;
    boykisser|Boykisser) wh_q="cat kiss pastel" ;;
  esac
  wh=""; nb=""; wa=""; sb=""; ov=""
  if [ "$src" = "all" ] || [ "$src" = "wallhaven" ]; then
    echo "searching SFW wallpapers for '$q' (wallhaven purity=100, q='$wh_q')..."
    wh=$(curl -fsSL --max-time 25 --max-filesize 2000000 -A "furarcher-asahi/ricer (SFW)" \
      "$WH_BASE/api/v1/search?q=$(python3 -c "import urllib.parse,sys; print(urllib.parse.quote(sys.argv[1]))" "$wh_q")&purity=100&sorting=toplist&page=1" 2>/dev/null || echo "")
  fi
  if [ "$src" = "all" ] || [ "$src" = "nekos" ]; then
    echo "checking nekos.best/$nb_ep (SFW)..."
    nb=$(curl -fsSL --max-time 25 -A "furarcher-asahi/ricer (SFW)" \
      "$NB_BASE/api/v2/$nb_ep?amount=$n" 2>/dev/null || echo "")
  fi
  if [ "$src" = "all" ] || [ "$src" = "waifu" ]; then
    echo "checking waifu.im (is_nsfw=false, SFW)..."
    wa=$(curl -fsSL --max-time 25 -A "furarcher-asahi/ricer (SFW)" \
      "$WA_BASE/search/?is_nsfw=false" -H "Accept: application/json" 2>/dev/null || echo "")
  fi
  # safebooru tags: SFW-only board, danbooru-style API. Mood-mapped, romantic/wholesome tags only.
  sb_tags=$(python3 -c "import urllib.parse,sys; print(urllib.parse.quote(sys.argv[1]))" "$q")
  case "$q" in
    boykisser|Boykisser|gaylove) sb_tags="boykisser" ;;
    mlm|achillean|boyfriend) sb_tags="2boys+holding_hands" ;;
    furry|paw|fox|wolf) sb_tags="furry" ;;
    femboy|Femboy) sb_tags="femboy" ;;
    bear) sb_tags="muscular" ;;
    midnight) sb_tags="night+cat_ears" ;;
  esac
  if [ "$src" = "all" ] || [ "$src" = "safebooru" ]; then
    echo "checking safebooru (SFW-only imageboard, tags='$sb_tags')..."
    sb=$(curl -fsSL --max-time 25 -A "furarcher-asahi/ricer (SFW)" \
      "$SB_BASE/index.php?page=dapi&s=post&q=index&json=1&limit=$n&tags=$sb_tags" 2>/dev/null || echo "")
  fi
  if [ "$src" = "all" ] || [ "$src" = "openverse" ]; then
    echo "checking openverse (CC images, q='$wh_q')..."
    ov=$(curl -fsSL --max-time 25 -A "furarcher-asahi/ricer (SFW)" \
      "$OV_BASE/v1/images/?q=$(python3 -c "import urllib.parse,sys; print(urllib.parse.quote(sys.argv[1]))" "$wh_q")&page_size=$n" -H "Accept: application/json" 2>/dev/null || echo "")
  fi
  WH_JSON="$wh" NB_JSON="$nb" WA_JSON="$wa" SB_JSON="$sb" OV_JSON="$ov" N="$n" Q="$q" SRC="$src" python3 - "$RCACHE/find.json" <<'PYEOF'
import json, os, sys
out = sys.argv[1]
res = []
try:
    d = json.loads(os.environ["WH_JSON"] or "{}")
    for x in d.get("data", [])[:int(os.environ["N"])]:
        res.append({"src": "wallhaven", "id": str(x.get("id", "?")),
                    "url": x.get("path"), "dims": f"{x.get('dimension_x')}x{x.get('dimension_y')}",
                    "credit": "wallhaven.cc/" + str(x.get("id", ""))})
except Exception:
    pass
try:
    d = json.loads(os.environ["NB_JSON"] or "{}")
    for x in d.get("results", [])[:int(os.environ["N"])]:
        dims = x.get("dimensions", {}) or {}
        res.append({"src": "nekos.best", "id": (x.get("url", "").split("/")[-1][:12] or "?"),
                    "url": x.get("url"), "dims": f"{dims.get('width')}x{dims.get('height')}",
                    "credit": str(x.get("artist_name", "unknown")) + " via " + str(x.get("source_url", ""))})
except Exception:
    pass
try:
    d = json.loads(os.environ["WA_JSON"] or "{}")
    imgs = d.get("images", [])
    if isinstance(imgs, dict):
        imgs = [imgs]
    for x in imgs[:int(os.environ["N"])]:
        if not isinstance(x, dict):
            continue
        url = x.get("url")
        if not url:
            continue
        w, h = x.get("width", "?"), x.get("height", "?")
        res.append({"src": "waifu.im", "id": str(x.get("image_id", url.split("/")[-1][:12])),
                    "url": url, "dims": f"{w}x{h}",
                    "credit": "SFW via " + str(x.get("source", "waifu.im"))})
except Exception:
    pass
try:
    d = json.loads(os.environ["SB_JSON"] or "[]")
    if isinstance(d, dict):
        d = d.get("post", []) or []
    for x in d[:int(os.environ["N"])]:
        if not isinstance(x, dict):
            continue
        url = x.get("file_url") or x.get("sample_url")
        if not url:
            continue
        if url.startswith("//"):
            url = "https:" + url
        res.append({"src": "safebooru", "id": str(x.get("id", "?")),
                    "url": url, "dims": f"{x.get('width', '?')}x{x.get('height', '?')}",
                    "credit": "safebooru.org/" + str(x.get("id", ""))})
except Exception:
    pass
try:
    d = json.loads(os.environ["OV_JSON"] or "{}")
    for x in d.get("results", [])[:int(os.environ["N"])]:
        if not isinstance(x, dict) or not x.get("url"):
            continue
        res.append({"src": "openverse", "id": str(x.get("id", "?"))[:12],
                    "url": x["url"], "dims": f"{x.get('width', '?')}x{x.get('height', '?')}",
                    "credit": "CC " + str(x.get("license", "?")) + " via " + str(x.get("provider", "openverse"))})
except Exception:
    pass
res = [r for r in res if r.get("url", "").startswith("http")]
json.dump({"query": os.environ["Q"], "results": res}, open(out, "w"), indent=1)
print(f"found {len(res)} SFW results for '{os.environ['Q']}':")
for i, r in enumerate(res, 1):
    print(f"  [{i}] {r['src']} {r['dims']} {r['credit']}\n      {r['url']}")
if not res:
    print("no results - try: fox, wolf, anime, neko, pastel, mlm, femboy, boykisser")
    print("tips: 'ricer find mlm --source=nekos' (husbando) | 'ricer find furry --source=all'")
PYEOF
}

cmd_get() { # get <n> [--apply[=theme]]
  [ -f "$RCACHE/find.json" ] || { echo "run 'ricer find <query>' first"; return 1; }
  apply=""; theme="boykisser"
  for a in "$@"; do case "$a" in --apply) apply=1;; --apply=*) apply=1; theme="${a#--apply=}";; esac; done
  idx="$1"
  url=$(python3 -c "import json,sys; print(json.load(open('$RCACHE/find.json'))['results'][int(sys.argv[1])-1]['url'])" "$idx" 2>/dev/null) \
    || { echo "no result #$idx - run 'ricer find' again"; return 1; }
  case "$url" in http://*|https://*) ;;
    *) echo "refusing non-http URL (safety): $url"; return 1 ;;
  esac
  mkdir -p "$BGDIR"
  base=$(basename "${url%%\?*}")
  [ -n "$base" ] && [ "$base" != "/" ] || base="web-$idx.png"
  tmp="$BGDIR/.dl-$base.tmp"
  echo "downloading #$idx -> $BGDIR/$base"
  curl -fsSL --max-time 60 --max-filesize 26214400 -A "furarcher-asahi/ricer (SFW)" -o "$tmp" "$url" || { echo "download failed"; rm -f "$tmp"; return 1; }
  if command -v file >/dev/null 2>&1; then
    ftype=$(file -b "$tmp" 2>/dev/null || echo "")
    case "$ftype" in *image*|*PNG*|*JPEG*|*SVG*|*WebP*) ;;
      *) echo "refusing non-image download ($ftype) - deleted"; rm -f "$tmp"; return 1 ;;
    esac
  fi
  mv -f "$tmp" "$BGDIR/$base"
  echo "$(date -u +%FT%TZ) #$idx $base $url" >> "$RCACHE/downloads.log"
  echo "saved: $BGDIR/$base"
  if [ -n "$apply" ]; then do_wallpaper "$BGDIR/$base" && do_theme "$theme"; fi
}

cmd_preview() { # preview <n> — print URL + best-effort inline image
  [ -f "$RCACHE/find.json" ] || { echo "run 'ricer find <query>' first"; return 1; }
  idx="$1"
  url=$(python3 -c "import json,sys; d=json.load(open('$RCACHE/find.json')); r=d['results'][int(sys.argv[1])-1]; print(r['src']+' | '+r.get('dims','?')+' | '+r['url'])" "$idx" 2>/dev/null) \
    || { echo "no result #$idx - run 'ricer find' again"; return 1; }
  echo "$url"
  if command -v kitty >/dev/null 2>&1 && command -v curl >/dev/null 2>&1; then
    tmp="/tmp/furarcher-preview-$idx.png"
    if curl -fsSL --max-time 20 --max-filesize 15000000 -o "$tmp" "$(echo "$url" | awk -F' \\| ' '{print $NF}')" 2>/dev/null; then
      kitty +kitten icat "$tmp" 2>/dev/null || true
    fi
  elif command -v chafa >/dev/null 2>&1; then
    echo "(chafa preview: chafa <downloaded file> after 'ricer get $idx')"
  fi
}

cmd_fetchpack() { # fetch-pack <mood> [n] [--apply-first[=theme]] — download top n web hits for a mood
  mood="${1:-boykisser}"; count="${2:-4}"; apply_first=""
  for a in "$@"; do case "$a" in --apply-first) apply_first=1;; --apply-first=*) apply_first=1;; esac; done
  case "$mood" in boykisser|mlm|furry|femboy|gaylove|midnight|bear|achillean) ;;
    *) echo "unknown pack: $mood (boykisser|mlm|furry|femboy|gaylove|midnight|bear|achillean)" >&2; return 1 ;;
  esac
  echo "fetching SFW web pack for mood '$mood' (top $count)..."
  cmd_find "$mood" "$count" --source=all || return 1
  theme="$(mood_theme "$mood")"
  ok=0; i=1
  while [ "$i" -le "$count" ]; do
    if [ "$i" = "1" ] && [ -n "$apply_first" ]; then
      if cmd_get "$i" --apply="$theme"; then ok=$((ok+1)); fi
    else
      if cmd_get "$i"; then ok=$((ok+1)); fi
    fi
    i=$((i+1))
  done
  echo "pack: $ok/$count saved to $BGDIR (log: $RCACHE/downloads.log)"
}

cmd_auto() { # auto <mood> — fully automatic: web search -> top hit -> full rice (wallpaper+theme+dark+dock). Falls back to bundled on empty/offline.
  mood="${1:-boykisser}"
  case "$mood" in boykisser|mlm|furry|femboy|gaylove|midnight|bear|achillean) ;;
    *) echo "unknown mood: $mood (boykisser|mlm|furry|femboy|gaylove|midnight|bear|achillean)" >&2; return 1 ;;
  esac
  theme="$(mood_theme "$mood")"
  echo "auto-ricing '$mood' from the web (SFW, 5 providers)..."
  if cmd_find "$mood" 4 --source=all; then
    got=$(python3 -c "import json; print(len(json.load(open('$RCACHE/find.json'))['results']))" 2>/dev/null || echo 0)
    if [ "${got:-0}" -gt 0 ] 2>/dev/null; then
      echo "top web hit -> full rice..."
      if cmd_get 1 --apply="$theme"; then
        do_darkmode; do_dock; do_macbinds; do_love "$mood" || true
        echo "auto-riced ^_^ (web #$mood + $theme, dark, dock, macbinds)"
        return 0
      fi
      echo "web download failed - falling back to bundled '$mood'."
    else
      echo "web empty (offline?) - falling back to bundled '$mood'."
    fi
  else
    echo "web search failed - falling back to bundled '$mood'."
  fi
  do_mood "$mood" && do_dock && do_macbinds
  echo "auto-riced ^_^ (bundled $mood fallback, dark, dock, macbinds)"
}

case "${1:-status}" in
  apply)
    img=""; theme=""
    for a in "${2:-}" "${3:-}"; do case "$a" in ""|--*) ;; *) if [ -z "$img" ]; then img="$a"; else theme="$a"; fi ;; esac; done
    img="${img:-$ROOT/wallpapers/boykisser-dark-2560x1664.svg}"
    theme="${theme:-boykisser}"
    do_wallpaper "$img" && do_theme "$theme" || exit 1
    do_darkmode
    do_dock
    do_macbinds
    case "$img" in *.png|*.jpg|*.jpeg)
      if command -v wal >/dev/null 2>&1; then run "wal -i \"$img\" || true"; fi ;;
    esac
    echo "riced ^_^ ($theme, dark, dock, macbinds)"
    ;;
  wallpaper) shift; [ $# -ge 1 ] || { echo 'usage: ricer wallpaper <image>'; exit 1; }; do_wallpaper "$1" ;;
  theme) shift; [ $# -ge 1 ] || { echo 'usage: ricer theme <name> (see: ricer themes)'; exit 1; }; do_theme "$1" ;;
  themes) cmd_themes ;;
  mood) shift; [ $# -ge 1 ] || { echo 'usage: ricer mood <boykisser|mlm|furry|femboy|gaylove|midnight|bear|achillean>'; exit 1; }; do_mood "$1" ;;
  love) shift; a="${1:-}"; case "$a" in --*) a="";; esac; do_love "${a:-gaylove}" ;;
  wallpapers) cmd_wallpapers ;;
  darkmode) do_darkmode ;;
  dock) do_dock ;;
  macbinds) do_macbinds ;;
  mactheme) do_mactheme ;;
  gpu) do_gpu ;;
  chime) shift; a="${1:-}"; case "$a" in --*) a="";; esac; do_chime "${a:-boykisser}" ;;
  sounds) do_sounds ;;
  grub) shift; a="${1:-}"; case "$a" in --*) a="";; esac; do_grub "${a:-boykisser}" ;;
  splash) shift; a="${1:-}"; case "$a" in --*) a="";; esac; do_splash "${a:-boykisser}" ;;
  find) shift; [ $# -ge 1 ] || { echo 'usage: ricer find <query> [count] [--source=all|wallhaven|nekos|waifu|safebooru|openverse]'; exit 1; }; cmd_find "$@" ;;
  "get") shift; [ $# -ge 1 ] || { echo 'usage: ricer get <n> [--apply[=theme]]'; exit 1; }; cmd_get "$@" ;;
  preview) shift; [ $# -ge 1 ] || { echo 'usage: ricer preview <n>'; exit 1; }; cmd_preview "$@" ;;
  fetch-pack) shift; [ $# -ge 1 ] || { echo 'usage: ricer fetch-pack <boykisser|mlm|furry|femboy|gaylove|midnight|bear|achillean> [n]'; exit 1; }; cmd_fetchpack "$@" ;;
  auto) shift; a="${1:-}"; case "$a" in --*) a="";; esac; cmd_auto "${a:-boykisser}" ;;
  status) cmd_status ;;
  *) echo "usage: ricer {apply [IMAGE] [theme]|wallpaper|theme|themes|mood|love|wallpapers|darkmode|dock|macbinds|mactheme|gpu|chime|grub|splash|find|get|preview|fetch-pack|auto|sounds|status} [--dry-run]"; exit 1 ;;
esac
