{"layer": "top", "position": "top", "height": 30, "spacing": 4, "modules-left": ["custom/os", "hyprland/workspaces", "hyprland/window"], "modules-center": ["clock"], "modules-right": ["cpu", "memory", "battery", "network", "pulseaudio", "tray"], "custom/os": {"format": "boykisser os", "tooltip": "furarcher asahi ^_^"}, "clock": {"format": "{:%a %b %d  %I:%M %p}", "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"}, "cpu": {"format": " {usage}%", "interval": 5}, "memory": {"format": " {percentage}%"}, "battery": {"format": "{capacity}% {icon}", "format-icons": ["", "", "", "", ""]}, "network": {"format-wifi": " {essid}", "format-disconnected": "⚠ offline"}, "pulseaudio": {"format": "{icon} {volume}%", "format-muted": "🔇 muted"}, "tray": {"spacing": 8}}
